{
  "actionLists": {
    "drawLibrary": [
      ["COND",
        ["GROUP_EMPTY", "{{$PLAYER_N}}Library"],
        ["LOG", "{{$ALIAS_N}} tried to draw from an empty library."],
        ["TRUE"],
        [
          ["MOVE_STACKS", "{{$PLAYER_N}}Library", "{{$PLAYER_N}}Hand", 1, "bottom"],
          ["LOG", "{{$ALIAS_N}} drew a card."]
        ]
      ]
    ],
    "drawCrypt": [
      ["COND",
        ["GROUP_EMPTY", "{{$PLAYER_N}}Crypt"],
        ["LOG", "{{$ALIAS_N}} tried to draw from an empty crypt."],
        ["TRUE"],
        [
          ["MOVE_STACKS", "{{$PLAYER_N}}Crypt", "{{$PLAYER_N}}Uncontrolled", 1, "bottom"],
          ["LOG", "{{$ALIAS_N}} moved the top crypt card to Uncontrolled."]
        ]
      ]
    ],
    "shuffleLibrary": [
      ["SHUFFLE_GROUP", "{{$PLAYER_N}}Library"],
      ["LOG", "{{$ALIAS_N}} shuffled their library."]
    ],
    "shuffleCrypt": [
      ["SHUFFLE_GROUP", "{{$PLAYER_N}}Crypt"],
      ["LOG", "{{$ALIAS_N}} shuffled their crypt."]
    ],
    "unlockAll": [
      ["FOR_EACH_KEY_VAL", "$CARD_ID", "$CARD", "$GAME.cardById",
        ["COND",
          ["EQUAL", "$CARD.controller", "$PLAYER_N"],
          ["SET", "/cardById/{{$CARD_ID}}/rotation", 0]
        ]
      ],
      ["LOG", "{{$ALIAS_N}} unlocked all their cards."]
    ],
    "lockCard": [
      ["SET", "/cardById/$ACTIVE_CARD_ID/rotation", 90],
      ["LOG", "{{$ALIAS_N}} locked {{$ACTIVE_FACE.name}}."]
    ],
    "unlockCard": [
      ["SET", "/cardById/$ACTIVE_CARD_ID/rotation", 0],
      ["LOG", "{{$ALIAS_N}} unlocked {{$ACTIVE_FACE.name}}."]
    ],
    "increasePool": [
      ["INCREASE_VAL", "/playerData/$PLAYER_N/pool", 1],
      ["LOG", "{{$ALIAS_N}} gained 1 pool."]
    ],
    "decreasePool": [
      ["COND",
        ["GREATER_THAN", "$GAME.playerData.$PLAYER_N.pool", 0],
        [
          ["DECREASE_VAL", "/playerData/$PLAYER_N/pool", 1],
          ["LOG", "{{$ALIAS_N}} burned 1 pool."]
        ],
        ["TRUE"],
        ["LOG", "{{$ALIAS_N}} is already at 0 pool."]
      ]
    ],
    "increaseVp": [
      ["INCREASE_VAL", "/playerData/$PLAYER_N/victoryPoints", 1],
      ["LOG", "{{$ALIAS_N}} gained 1 victory point."]
    ],
    "decreaseVp": [
      ["COND",
        ["GREATER_THAN", "$GAME.playerData.$PLAYER_N.victoryPoints", 0],
        [
          ["DECREASE_VAL", "/playerData/$PLAYER_N/victoryPoints", 1],
          ["LOG", "{{$ALIAS_N}} lost 1 victory point."]
        ],
        ["TRUE"],
        ["LOG", "{{$ALIAS_N}} is already at 0 victory points."]
      ]
    ],
    "roll1d6": [
      ["VAR", "$D1", ["RANDOM_INT", 1, 6]],
      ["LOG", "{{$ALIAS_N}} rolled 1d6: {{$D1}}."],
      ["FADE_TEXT_GAME", "{{$ALIAS_N}} 1d6: {{$D1}}"]
    ],
    "flipCoin": [
      ["VAR", "$FLIP", ["RANDOM_INT", 0, 1]],
      ["COND",
        ["EQUAL", "$FLIP", 0],
        [
          ["LOG", "{{$ALIAS_N}} flipped a coin: Heads."],
          ["FADE_TEXT_GAME", "{{$ALIAS_N}} Heads"]
        ],
        ["TRUE"],
        [
          ["LOG", "{{$ALIAS_N}} flipped a coin: Tails."],
          ["FADE_TEXT_GAME", "{{$ALIAS_N}} Tails"]
        ]
      ]
    ],
    "flipCard": [
      ["FLIP", "$ACTIVE_CARD_ID"]
    ],
    "discardCard": [
      ["DISCARD", "$ACTIVE_CARD_ID"]
    ],
    "detachCard": [
      ["DETACH", "$ACTIVE_CARD_ID"]
    ],
    "shuffleIntoDeck": [
      ["SHUFFLE_INTO_DECK", "$ACTIVE_CARD_ID"]
    ]
  }
}
