{
  "pluginName": "WARS Trading Card Game",
  "author": "usmcgeek",
  "defaultActions": [
    {
      "actionList": "invertCard",
      "condition": [
        "AND",
        [
          "EQUAL",
          "$ACTIVE_CARD.currentSide",
          "A"
        ],
        "$ACTIVE_CARD.inPlay",
        [
          "MAP_HAS_KEY",
          "$ACTIVE_CARD.sides",
          "C"
        ]
      ],
      "label": "id:invert"
    },
    {
      "actionList": "invertCard",
      "condition": [
        "AND",
        [
          "EQUAL",
          "$ACTIVE_CARD.currentSide",
          "C"
        ],
        "$ACTIVE_CARD.inPlay"
      ],
      "label": "id:invert"
    },
    {
      "actionList": "damageCard",
      "condition": [
        "AND",
        [
          "EQUAL",
          "$ACTIVE_CARD.rotation",
          0
        ],
        "$ACTIVE_CARD.inPlay"
      ],
      "label": "id:damage"
    },
    {
      "actionList": "damageCard",
      "condition": [
        "AND",
        [
          "EQUAL",
          "$ACTIVE_CARD.rotation",
          90
        ],
        "$ACTIVE_CARD.inPlay"
      ],
      "label": "id:damage"
    }
  ],
