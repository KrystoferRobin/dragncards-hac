{
  "pluginName": "Marvel Champions: The Card Game",
  "defaultActions": [
    {
      "actionList": [],
      "condition": [
        "IN_STRING",
        "$ACTIVE_CARD.groupId",
        "Hand"
      ],
      "label": ""
    },
    {
      "actionList": "shuffleIntoDeck",
      "condition": [
        "EQUAL",
        "$ACTIVE_CARD.layoutType",
        "pile"
      ],
      "label": "id:shuffle"
    },
    {
      "actionList": "flipCard",
      "condition": [
        "AND",
        [
          "EQUAL",
          "$ACTIVE_CARD.currentSide",
          "B"
        ],
        [
          "NOT_EQUAL",
          "$ACTIVE_CARD.sides.A.type",
          "Main Scheme"
        ]
      ],
      "label": "id:flipButton",
      "position": "bottom"
    },
    {
      "actionList": "flipCard",
      "condition": [
        "EQUAL",
        "$ACTIVE_FACE.type",
        "Hero"
      ],
      "label": "id:flipButton",
      "position": "bottom"
    },
    {
      "actionList": "flipCard",
      "condition": [
        "AND",
        [
          "EQUAL",
          "$ACTIVE_CARD.sides.A.type",
          "Main Scheme"
        ],
        [
          "EQUAL",
          "$ACTIVE_CARD.currentSide",
          "A"
        ]
      ],
      "label": "id:flipButton",
      "position": "bottom"
    },
    {
      "actionList": [
        [
          "LOG",
          "{{$ALIAS_N}} removed 1 threat token from {{$ACTIVE_FACE.name}}."
        ],
        [
          "DECREASE_VAL",
          "/cardById/$ACTIVE_CARD_ID/tokens/threat",
          1
        ]
      ],
      "condition": [
        "GREATER_THAN",
        "$ACTIVE_TOKENS.threat",
        0
      ],
      "label": "id:thwart"
    },
    {
      "actionList": [
        "DISCARD_CARD",
        "$ACTIVE_CARD_ID"
      ],
      "condition": [
        "AND",
        [
          "IN_STRING",
          "$ACTIVE_FACE.type",
          "Scheme"
        ],
        [
          "EQUAL",
          "$ACTIVE_TOKENS.threat",
          0
        ]
      ],
      "label": "id:discard"
    },
    {
      "actionList": [
        "DISCARD_CARD",
        "$ACTIVE_CARD_ID"
      ],
      "condition": [
        "AND",
        [
          "IN_STRING",
          "$ACTIVE_FACE.type",
          "Scheme"
        ],
        [
          "EQUAL",
          "$ACTIVE_TOKENS.threat",
          0
        ]
      ],
      "label": "id:discard"
    },
    {
      "actionList": [
        [
          "LOG",
          "{{$ALIAS_N}} added 1 damage token to {{$ACTIVE_FACE.name}}."
        ],
        [
          "INCREASE_VAL",
          "/cardById/$ACTIVE_CARD_ID/tokens/damage",
          1
        ]
      ],
      "condition": [
        "AND",
        [
          "EQUAL",
          "$ACTIVE_FACE.type",
          "Minion"
        ],
        [
          "OR",
          [
            "LESS_THAN",
            "$ACTIVE_TOKENS.damage",
            "$ACTIVE_FACE.hitPoints"
          ],
          [
            "LESS_THAN",
            "$ACTIVE_TOKENS.damage",
            "$ACTIVE_FACE.hitPointsFixed"
          ]
        ]
      ],
      "label": "id:damage"
    },
    {
      "actionList": [
        "DISCARD_CARD",
        "$ACTIVE_CARD_ID"
      ],
      "condition": [
        "AND",
        [
          "EQUAL",
          "$ACTIVE_FACE.type",
          "Minion"
        ],
        [
          "OR",
          [
            "GREATER_EQUAL",
            "$ACTIVE_TOKENS.damage",
            "$ACTIVE_FACE.hitPoints"
          ],
          [
            "GREATER_EQUAL",
            "$ACTIVE_TOKENS.damage",
            "$ACTIVE_FACE.hitPointsFixed"
          ]
        ]
      ],
      "label": "id:discard"
    },
    {
      "actionList": [
        "DISCARD_CARD",
        "$ACTIVE_CARD_ID"
      ],
      "condition": [
        "EQUAL",
        "$ACTIVE_FACE.type",
        "Treachery"
      ],
      "label": "id:discard"
    },
    {
      "actionList": [
        "DISCARD_CARD",
        "$ACTIVE_CARD_ID"
      ],
      "condition": [
        "EQUAL",
        "$ACTIVE_FACE.type",
        "Event"
      ],
      "label": "id:discard"
    },
    {
      "actionList": [],
      "condition": [
        "IN_STRING",
        "$ACTIVE_FACE.type",
        "Scheme"
      ],
      "label": ""
    },
    {
      "actionList": "toggleExhaust",
      "condition": [
        "EQUAL",
        "$ACTIVE_CARD.rotation",
        0
      ],
      "label": "id:exhaust"
    },
    {
      "actionList": "toggleExhaust",
      "condition": [
        "EQUAL",
        "$ACTIVE_CARD.rotation",
        90
      ],
      "label": "id:ready"
    }
  ],
