      "label": "id:add to VD"
    },
    {
      "actionList": "discardCard",
      "condition": [
        "AND",
        [
          "EQUAL",
          "$ACTIVE_FACE.type",
          "Location"
        ],
        [
          "GREATER_EQUAL",
          "$ACTIVE_CARD.tokens.progress",
          "$ACTIVE_FACE.questPoints"
        ]
      ],
      "label": "id:discard"
    },
    {
      "actionList": "discardCard",
      "condition": [
        "EQUAL",
        "$ACTIVE_FACE.type",
        "Event"
      ],
      "label": "id:discard"
    },
    {
      "actionList": "toggleExhaust",
      "condition": [
        "EQUAL",
        "$ACTIVE_CARD.rotation",
        0
      ],
      "label": "id:exhaust"
    },
    {
      "actionList": "toggleExhaust",
      "condition": [
        "EQUAL",
        "$ACTIVE_CARD.rotation",
        90
      ],
      "label": "id:ready"
    }
  ],
