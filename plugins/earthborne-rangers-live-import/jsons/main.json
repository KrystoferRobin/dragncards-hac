{
  "pluginName": "Earthborne Rangers",
  "defaultActions": [
    {
      "actionList": [],
      "condition": [
        "EQUAL",
        "$ACTIVE_CARD.layoutType",
        "horizontalFan"
      ],
      "label": ""
    },
    {
      "actionList": "flipCard",
      "condition": [
        "AND",
        [
          "EQUAL",
          "$ACTIVE_CARD.rotation",
          -30
        ],
        [
          "EQUAL",
          "$ACTIVE_CARD.currentSide",
          "B"
        ]
      ],
      "label": "id:flip",
      "position": "bottom"
    },
    {
      "actionList": "discardCard",
      "condition": [
        "AND",
        [
          "EQUAL",
          "$ACTIVE_CARD.rotation",
          -30
        ],
        [
          "EQUAL",
          "$ACTIVE_CARD.currentSide",
          "A"
        ]
      ],
      "label": "id:discard",
      "position": "bottom"
    },
    {
      "actionList": "shuffleIntoDeck",
      "condition": [
        "EQUAL",
        "$ACTIVE_CARD.layoutType",
        "pile"
      ],
      "label": "id:shuffle"
    },
    {
      "actionList": "flipCard",
      "condition": [
        "AND",
        [
          "EQUAL",
          "$ACTIVE_FACE.type",
          "Quest"
        ],
        [
          "EQUAL",
          "$ACTIVE_CARD.currentSide",
          "A"
        ]
      ],
      "label": "id:flip"
    },
    {
      "actionList": "addProgress",
      "condition": [
        "AND",
        [
          "EQUAL",
          "$ACTIVE_FACE.type",
          "Quest"
        ],
        [
          "LESS_EQUAL",
          "$ACTIVE_CARD.tokens.progress",
          "$ACTIVE_FACE.questPoints"
        ]
      ],
      "label": "id:progress"
    },
    {
      "actionList": "discardCard",
      "condition": [
        "AND",
        [
          "EQUAL",
          "$ACTIVE_FACE.type",
          "Quest"
        ],
        [
          "GREATER_EQUAL",
          "$ACTIVE_CARD.tokens.progress",
          "$ACTIVE_FACE.questPoints"
        ]
      ],
      "label": "id:discard"
    },
    {
      "actionList": "flipCard",
      "condition": [
        "AND",
        [
          "EQUAL",
          "$ACTIVE_CARD.currentSide",
          "B"
        ],
        "$ACTIVE_CARD.inPlay"
      ],
      "label": "id:flip"
    },
    {
      "actionList": "addDamage",
      "condition": [
        "AND",
        [
          "EQUAL",
          "$ACTIVE_FACE.type",
          "Enemy"
        ],
        [
          "LESS_THAN",
          "$ACTIVE_CARD.tokens.damage",
          "$ACTIVE_FACE.hitPoints"
        ]
      ],
      "label": "id:damage"
    },
    {
      "actionList": "addToVictoryDisplay",
      "condition": [
        "AND",
        [
          "EQUAL",
          "$ACTIVE_FACE.type",
          "Enemy"
        ],
        [
          "GREATER_EQUAL",
          "$ACTIVE_CARD.tokens.damage",
          "$ACTIVE_FACE.hitPoints"
        ],
        "$ACTIVE_FACE.victoryPoints",
        [
          "GREATHER_THAN",
          "$ACTIVE_FACE.victoryPoints",
          0
        ]
      ],
      "label": "id:add to VD"
    },
    {
      "actionList": "discardCard",
      "condition": [
        "AND",
        [
          "EQUAL",
          "$ACTIVE_FACE.type",
          "Enemy"
        ],
        [
          "GREATER_EQUAL",
          "$ACTIVE_CARD.tokens.damage",
