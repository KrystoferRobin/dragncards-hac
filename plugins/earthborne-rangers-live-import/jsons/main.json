          "Location"
        ],
        [
          "LESS_THAN",
          "$ACTIVE_CARD.tokens.progress",
          "$ACTIVE_FACE.questPoints"
        ]
      ],
      "label": "id:progress"
    },
    {
      "actionList": "addToVictoryDisplay",
      "condition": [
        "AND",
        [
          "EQUAL",
          "$ACTIVE_FACE.type",
          "Location"
        ],
        [
          "GREATER_EQUAL",
          "$ACTIVE_CARD.tokens.progress",
          "$ACTIVE_FACE.questPoints"
        ],
        "$ACTIVE_FACE.victoryPoints",
        [
          "GREATHER_THAN",
          "$ACTIVE_FACE.victoryPoints",
