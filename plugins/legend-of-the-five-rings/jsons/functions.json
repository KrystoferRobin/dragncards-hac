{
  "functions": {
    "DISCARD": {
      "args": [
        "$CARD_ID"
      ],
      "code": [
        [
          "VAR",
          "$CARD",
          "$GAME.cardById.$CARD_ID"
        ],
        [
          "COND",
          [
            "EQUAL",
            "$CARD.databaseId",
            "l5r-imperial-favor"
          ],
          [
            [
              "MOVE_CARD",
              "$CARD.id",
              "sharedFavor",
              0
            ],
            [
              "RESET_FAVOR_ART",
              "$CARD.id"
            ],
            [
              "LOG",
              "{{$ALIAS_N}} returned the Imperial Favor."
            ]
          ],
          [
            "OR",
            [
              "EQUAL",
              "$CARD.currentFace.type",
              "Personality"
            ],
            [
              "EQUAL",
              "$CARD.currentFace.type",
              "Holding"
            ],
            [
              "EQUAL",
              "$CARD.currentFace.type",
              "Event"
            ],
            [
              "EQUAL",
              "$CARD.currentFace.type",
              "Region"
            ],
            [
              "EQUAL",
              "$CARD.currentFace.type",
              "Ancestor"
            ],
            [
              "EQUAL",
              "$CARD.currentFace.type",
              "Celestial"
            ],
            [
              "EQUAL",
              "$CARD.currentFace.type",
              "Stronghold"
            ],
            [
              "EQUAL",
              "$CARD.currentFace.type",
              "Sensei"
            ],
            [
              "EQUAL",
              "$CARD.currentFace.type",
              "Wind"
            ]
          ],
          [
            [
              "MOVE_CARD",
              "$CARD.id",
              "{{$CARD.controller}}DynastyDiscard",
              0
            ],
            [
              "LOG",
              "{{$ALIAS_N}} discarded {{$CARD.sides.A.name}} to the dynasty discard."
            ]
          ],
          [
            "TRUE"
          ],
          [
            [
              "MOVE_CARD",
              "$CARD.id",
              "{{$CARD.controller}}FateDiscard",
              0
            ],
            [
              "LOG",
              "{{$ALIAS_N}} discarded {{$CARD.sides.A.name}} to the fate discard."
            ]
          ]
        ]
      ]
    },
    "FLIP": {
      "args": [
        "$CARD_ID"
      ],
      "code": [
        [
          "VAR",
          "$CARD",
          "$GAME.cardById.$CARD_ID"
        ],
        [
          "COND",
          [
            "EQUAL",
            "$CARD.currentSide",
            "A"
          ],
          [
            [
              "LOG",
              "{{$ALIAS_N}} flipped {{$CARD.currentFace.name}} facedown."
            ],
            [
              "SET",
              "/cardById/$CARD.id/currentSide",
              "B"
            ]
          ],
          [
            "TRUE"
          ],
          [
            [
              "SET",
              "/cardById/$CARD.id/currentSide",
              "A"
            ],
            [
              "LOG",
              "{{$ALIAS_N}} flipped {{$CARD.currentFace.name}} faceup."
            ]
          ]
        ]
      ]
    },
    "DETACH": {
      "args": [
        "$CARD_ID"
      ],
      "code": [
        [
          "VAR",
          "$CARD",
          "$GAME.cardById.$CARD_ID"
        ],
        [
          "COND",
          [
            "GREATER_THAN",
            "$CARD.cardIndex",
            0
          ],
          [
            [
              "MOVE_CARD",
              "$CARD.id",
              "$CARD.groupId",
              [
                "ADD",
                "$CARD.stackIndex",
                1
              ]
            ],
            [
              "LOG",
              "{{$ALIAS_N}} detached {{$CARD.currentFace.name}}."
            ]
          ]
        ]
      ]
    },
    "SHUFFLE_INTO_DECK": {
      "args": [
        "$CARD_ID"
      ],
      "code": [
        [
          "VAR",
          "$CARD",
          "$GAME.cardById.$CARD_ID"
        ],
        [
          "VAR",
          "$GROUP_ID",
          "$CARD.deckGroupId"
        ],
        [
          "COND",
          [
            "EQUAL",
            "$GROUP_ID",
            null
          ],
          [
            "LOG",
            "{{$ALIAS_N}} failed to shuffle {{$CARD.currentFace.name}} into a deck."
          ],
          [
            "TRUE"
          ],
          [
            [
              "MOVE_CARD",
              "$CARD.id",
              "$CARD.deckGroupId",
              0
            ],
            [
              "SHUFFLE_GROUP",
              "$GROUP_ID"
            ],
            [
              "LOG",
              "{{$ALIAS_N}} shuffled {{$CARD.currentFace.name}} into {{$GAME.groupById.$GROUP_ID.label}}."
            ]
          ]
        ]
      ]
    },
    "START_TURN": {
      "args": [
        "$WHO"
      ],
      "code": [
        [
          "FOR_EACH_KEY_VAL",
          "$CARD_ID",
          "$CARD",
          "$GAME.cardById",
          [
            "COND",
            [
              "AND",
              [
                "EQUAL",
                "$CARD.controller",
                "$WHO"
              ],
              [
                "NOT_EQUAL",
                "$CARD.tokens.stayBowed",
                1
              ],
              [
                "NOT_EQUAL",
                "$CARD.rotation",
                180
              ]
            ],
            [
              "SET",
              "/cardById/{{$CARD_ID}}/rotation",
              0
            ]
          ]
        ],
        [
          "FOR_EACH_KEY_VAL",
          "$CARD_ID",
          "$CARD",
          "$GAME.cardById",
          [
            "COND",
            [
              "AND",
              [
                "EQUAL",
                "$CARD.controller",
                "$WHO"
              ],
              [
                "IN_STRING",
                "$CARD.groupId",
                "Province"
              ],
              [
                "NOT_EQUAL",
                "$CARD.tokens.stayFlip",
                1
              ]
            ],
            [
              "SET",
              "/cardById/{{$CARD_ID}}/currentSide",
              "A"
            ]
          ]
        ],
        [
          "LOG",
          [
            "GET_ALIAS",
            "$WHO"
          ],
          " straightened and revealed provinces (held and dishonored cards stayed)."
        ]
      ]
    },
    "REFILL_PROVINCE": {
      "args": [
        "$PROVINCE_ID"
      ],
      "code": [
        [
          "COND",
          [
            "AND",
            [
              "IN_STRING",
              "$PROVINCE_ID",
              "Province"
            ],
            [
              "GROUP_EMPTY",
              "$PROVINCE_ID"
            ],
            [
              "NOT",
              [
                "EQUAL",
                "$GAME.groupById.$PROVINCE_ID.destroyed",
                true
              ]
            ]
          ],
          [
            [
              "VAR",
              "$OWNER",
              [
                "REGEX_REPLACE",
                "$PROVINCE_ID",
                "(player[0-9]+).*",
                "\\1"
              ]
            ],
            [
              "COND",
              [
                "NOT",
                [
                  "GROUP_EMPTY",
                  "{{$OWNER}}Dynasty"
                ]
              ],
              [
                [
                  "MOVE_STACKS",
                  "{{$OWNER}}Dynasty",
                  "$PROVINCE_ID",
                  1,
                  "bottom"
                ],
                [
                  "LOG",
                  "A dynasty card filled the empty province face-down."
                ]
              ]
            ]
          ]
        ]
      ]
    },
    "ADD_FACEDOWN_DYNASTY": {
      "args": [
        "$PROVINCE_ID"
      ],
      "code": [
        [
          "COND",
          [
            "AND",
            [
              "IN_STRING",
              "$PROVINCE_ID",
              "Province"
            ],
            [
              "NOT",
              [
                "EQUAL",
                "$GAME.groupById.$PROVINCE_ID.destroyed",
                true
              ]
            ]
          ],
          [
            [
              "VAR",
              "$OWNER",
              [
                "REGEX_REPLACE",
                "$PROVINCE_ID",
                "(player[0-9]+).*",
                "\\1"
              ]
            ],
            [
              "COND",
              [
                "NOT",
                [
                  "GROUP_EMPTY",
                  "{{$OWNER}}Dynasty"
                ]
              ],
              [
                [
                  "MOVE_STACKS",
                  "{{$OWNER}}Dynasty",
                  "$PROVINCE_ID",
                  1,
                  "bottom"
                ],
                [
                  "LOG",
                  "A dynasty card filled the province face-down."
                ]
              ]
            ]
          ]
        ]
      ]
    },
    "APPLY_FAVOR_ART": {
      "args": [
        "$WHO",
        "$CARD_ID"
      ],
      "code": [
        [
          "COND",
          [
            "EQUAL",
            "$GAME.playerData.$WHO.clan",
            "crab"
          ],
          [
            [
              "SET",
              "/cardById/{{$CARD_ID}}/sides/A/imageUrl",
              "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-ImperialFavorCrab.jpg"
            ],
            [
              "SET",
              "/cardById/{{$CARD_ID}}/sides/A/zoomImageUrl",
              "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-ImperialFavorCrab.jpg"
            ]
          ],
          [
            "EQUAL",
            "$GAME.playerData.$WHO.clan",
            "crane"
          ],
          [
            [
              "SET",
              "/cardById/{{$CARD_ID}}/sides/A/imageUrl",
              "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-ImperialFavorCrane.jpg"
            ],
            [
              "SET",
              "/cardById/{{$CARD_ID}}/sides/A/zoomImageUrl",
              "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-ImperialFavorCrane.jpg"
            ]
          ],
          [
            "EQUAL",
            "$GAME.playerData.$WHO.clan",
            "dragon"
          ],
          [
            [
              "SET",
              "/cardById/{{$CARD_ID}}/sides/A/imageUrl",
              "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-ImperialFavorDragon.jpg"
            ],
            [
              "SET",
              "/cardById/{{$CARD_ID}}/sides/A/zoomImageUrl",
              "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-ImperialFavorDragon.jpg"
            ]
          ],
          [
            "EQUAL",
            "$GAME.playerData.$WHO.clan",
            "lion"
          ],
          [
            [
              "SET",
              "/cardById/{{$CARD_ID}}/sides/A/imageUrl",
              "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-ImperialFavorLion.jpg"
            ],
            [
              "SET",
              "/cardById/{{$CARD_ID}}/sides/A/zoomImageUrl",
              "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-ImperialFavorLion.jpg"
            ]
          ],
          [
            "EQUAL",
            "$GAME.playerData.$WHO.clan",
            "mantis"
          ],
          [
            [
              "SET",
              "/cardById/{{$CARD_ID}}/sides/A/imageUrl",
              "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-ImperialFavorMantis.jpg"
            ],
            [
              "SET",
              "/cardById/{{$CARD_ID}}/sides/A/zoomImageUrl",
              "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-ImperialFavorMantis.jpg"
            ]
          ],
          [
            "EQUAL",
            "$GAME.playerData.$WHO.clan",
            "phoenix"
          ],
          [
            [
              "SET",
              "/cardById/{{$CARD_ID}}/sides/A/imageUrl",
              "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-ImperialFavorPhoenix.jpg"
            ],
            [
              "SET",
              "/cardById/{{$CARD_ID}}/sides/A/zoomImageUrl",
              "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-ImperialFavorPhoenix.jpg"
            ]
          ],
          [
            "EQUAL",
            "$GAME.playerData.$WHO.clan",
            "scorpion"
          ],
          [
            [
              "SET",
              "/cardById/{{$CARD_ID}}/sides/A/imageUrl",
              "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-ImperialFavorScorpion.jpg"
            ],
            [
              "SET",
              "/cardById/{{$CARD_ID}}/sides/A/zoomImageUrl",
              "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-ImperialFavorScorpion.jpg"
            ]
          ],
          [
            "EQUAL",
            "$GAME.playerData.$WHO.clan",
            "spider"
          ],
          [
            [
              "SET",
              "/cardById/{{$CARD_ID}}/sides/A/imageUrl",
              "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-ImperialFavorSpider.jpg"
            ],
            [
              "SET",
              "/cardById/{{$CARD_ID}}/sides/A/zoomImageUrl",
              "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-ImperialFavorSpider.jpg"
            ]
          ],
          [
            "EQUAL",
            "$GAME.playerData.$WHO.clan",
            "unicorn"
          ],
          [
            [
              "SET",
              "/cardById/{{$CARD_ID}}/sides/A/imageUrl",
              "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-ImperialFavorUnicorn.jpg"
            ],
            [
              "SET",
              "/cardById/{{$CARD_ID}}/sides/A/zoomImageUrl",
              "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-ImperialFavorUnicorn.jpg"
            ]
          ],
          [
            "TRUE"
          ],
          [
            [
              "SET",
              "/cardById/{{$CARD_ID}}/sides/A/imageUrl",
              "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-ImperialFavorGeneric.jpg"
            ],
            [
              "SET",
              "/cardById/{{$CARD_ID}}/sides/A/zoomImageUrl",
              "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-ImperialFavorGeneric.jpg"
            ]
          ]
        ]
      ]
    },
    "RESET_FAVOR_ART": {
      "args": [
        "$CARD_ID"
      ],
      "code": [
        [
          "SET",
          "/cardById/{{$CARD_ID}}/sides/A/imageUrl",
          "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-ImperialFavorGeneric.jpg"
        ],
        [
          "SET",
          "/cardById/{{$CARD_ID}}/sides/A/zoomImageUrl",
          "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-ImperialFavorGeneric.jpg"
        ]
      ]
    },
    "CLAIM_FAVOR": {
      "args": [
        "$WHO"
      ],
      "code": [
        [
          "VAR",
          "$FAVOR",
          [
            "ONE_CARD",
            "$C",
            [
              "EQUAL",
              "$C.databaseId",
              "l5r-imperial-favor"
            ]
          ]
        ],
        [
          "COND",
          [
            "EQUAL",
            "$FAVOR",
            null
          ],
          [
            "LOG",
            "The Imperial Favor is not on the table."
          ],
          [
            "TRUE"
          ],
          [
            [
              "MOVE_CARD",
              "$FAVOR.id",
              "{{$WHO}}Favor",
              0
            ],
            [
              "VAR",
              "$CARD_ID",
              "$FAVOR.id"
            ],
            [
              "APPLY_FAVOR_ART",
              "$WHO",
              "$CARD_ID"
            ],
            [
              "LOG",
              [
                "GET_ALIAS",
                "$WHO"
              ],
              " claimed the Imperial Favor."
            ]
          ]
        ]
      ]
    },
    "TOGGLE_PROVINCE_DESTROYED": {
      "args": [
        "$PROVINCE_ID"
      ],
      "code": [
        [
          "COND",
          [
            "EQUAL",
            "$GAME.groupById.$PROVINCE_ID.destroyed",
            true
          ],
          [
            [
              "SET",
              "/groupById/{{$PROVINCE_ID}}/destroyed",
              false
            ],
            [
              "LOG",
              "{{$ALIAS_N}} restored {{$GAME.groupById.$PROVINCE_ID.label}}."
            ],
            [
              "REFILL_PROVINCE",
              "$PROVINCE_ID"
            ]
          ],
          [
            "TRUE"
          ],
          [
            [
              "SET",
              "/groupById/{{$PROVINCE_ID}}/destroyed",
              true
            ],
            [
              "LOG",
              "{{$ALIAS_N}} destroyed {{$GAME.groupById.$PROVINCE_ID.label}}."
            ]
          ]
        ]
      ]
    }
  }
}
