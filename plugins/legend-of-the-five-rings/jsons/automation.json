{
  "automation": {
    "postNewGameActionList": [
      [
        "LOG",
        "Legend of the Five Rings table created. Load a starter or a community deck (clan, then format). Honor and gold live in the top bar. No rules are enforced."
      ],
      [
        "LOAD_CARDS",
        [
          "LIST",
          {
            "databaseId": "l5r-imperial-favor",
            "loadGroupId": "sharedFavor",
            "quantity": 1
          }
        ]
      ],
      [
        "FOR_EACH_KEY_VAL",
        "$CARD_ID",
        "$CARD",
        "$GAME.cardById",
        [
          "COND",
          [
            "EQUAL",
            "$CARD.databaseId",
            "l5r-imperial-favor"
          ],
          [
            [
              "SET",
              "/cardById/{{$CARD_ID}}/sides/A/imageUrl",
              "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-ImperialFavorGeneric.jpg"
            ],
            [
              "SET",
              "/cardById/{{$CARD_ID}}/sides/A/zoomImageUrl",
              "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-ImperialFavorGeneric.jpg"
            ]
          ]
        ]
      ]
    ],
    "postLoadActionList": [
      [
        "COND",
        [
          "GROUP_NOT_EMPTY",
          "{{$PLAYER_N}}Stronghold"
        ],
        [
          [
            "FOR_EACH_KEY_VAL",
            "$CARD_ID",
            "$CARD",
            "$GAME.cardById",
            [
              "COND",
              [
                "AND",
                [
                  "EQUAL",
                  "$CARD.controller",
                  "$PLAYER_N"
                ],
                [
                  "EQUAL",
                  "$CARD.currentFace.type",
                  "Stronghold"
                ]
              ],
              [
                [
                  "SET",
                  "/playerData/$PLAYER_N/clan",
                  "$CARD.currentFace.clan"
                ],
                [
                  "SET",
                  "/playerData/$PLAYER_N/honor",
                  [
                    "TO_INT",
                    "$CARD.currentFace.startingHonor"
                  ]
                ]
              ]
            ]
          ],
          [
            "FOR_EACH_KEY_VAL",
            "$CARD_ID",
            "$CARD",
            "$GAME.cardById",
            [
              "COND",
              [
                "EQUAL",
                "$CARD.groupId",
                "{{$PLAYER_N}}Mat"
              ],
              [
                [
                  "COND",
                  [
                    "EQUAL",
                    "$GAME.playerData.$PLAYER_N.clan",
                    "crab"
                  ],
                  [
                    "SET",
                    "/cardById/{{$CARD_ID}}/sides/A/imageUrl",
                    "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-MatCrab.jpg"
                  ],
                  [
                    "EQUAL",
                    "$GAME.playerData.$PLAYER_N.clan",
                    "crane"
                  ],
                  [
                    "SET",
                    "/cardById/{{$CARD_ID}}/sides/A/imageUrl",
                    "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-MatCrane.jpg"
                  ],
                  [
                    "EQUAL",
                    "$GAME.playerData.$PLAYER_N.clan",
                    "dragon"
                  ],
                  [
                    "SET",
                    "/cardById/{{$CARD_ID}}/sides/A/imageUrl",
                    "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-MatDragon.jpg"
                  ],
                  [
                    "EQUAL",
                    "$GAME.playerData.$PLAYER_N.clan",
                    "lion"
                  ],
                  [
                    "SET",
                    "/cardById/{{$CARD_ID}}/sides/A/imageUrl",
                    "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-MatLion.jpg"
                  ],
                  [
                    "EQUAL",
                    "$GAME.playerData.$PLAYER_N.clan",
                    "mantis"
                  ],
                  [
                    "SET",
                    "/cardById/{{$CARD_ID}}/sides/A/imageUrl",
                    "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-MatMantis.jpg"
                  ],
                  [
                    "EQUAL",
                    "$GAME.playerData.$PLAYER_N.clan",
                    "phoenix"
                  ],
                  [
                    "SET",
                    "/cardById/{{$CARD_ID}}/sides/A/imageUrl",
                    "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-MatPhoenix.jpg"
                  ],
                  [
                    "EQUAL",
                    "$GAME.playerData.$PLAYER_N.clan",
                    "scorpion"
                  ],
                  [
                    "SET",
                    "/cardById/{{$CARD_ID}}/sides/A/imageUrl",
                    "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-MatScorpion.jpg"
                  ],
                  [
                    "EQUAL",
                    "$GAME.playerData.$PLAYER_N.clan",
                    "spider"
                  ],
                  [
                    "SET",
                    "/cardById/{{$CARD_ID}}/sides/A/imageUrl",
                    "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-MatSpider.jpg"
                  ],
                  [
                    "EQUAL",
                    "$GAME.playerData.$PLAYER_N.clan",
                    "unicorn"
                  ],
                  [
                    "SET",
                    "/cardById/{{$CARD_ID}}/sides/A/imageUrl",
                    "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-MatUnicorn.jpg"
                  ],
                  [
                    "TRUE"
                  ],
                  [
                    "SET",
                    "/cardById/{{$CARD_ID}}/sides/A/imageUrl",
                    "legend-of-the-five-rings/_plugin/LegendOfTheFiveRings-MatDefault.jpg"
                  ]
                ]
              ]
            ]
          ],
          [
            "FOR_EACH_KEY_VAL",
            "$CARD_ID",
            "$CARD",
            "$GAME.cardById",
            [
              "COND",
              [
                "AND",
                [
                  "EQUAL",
                  "$CARD.controller",
                  "$PLAYER_N"
                ],
                [
                  "EQUAL",
                  "$CARD.currentFace.type",
                  "Stronghold"
                ],
                [
                  "IN_STRING",
                  "$CARD.currentFace.legal",
                  "emperor"
                ],
                [
                  "NOT_EQUAL",
                  [
                    "IN_STRING",
                    "$CARD.currentFace.legal",
                    "ivory"
                  ],
                  true
                ]
              ],
              [
                [
                  "LOAD_CARDS",
                  [
                    "LIST",
                    {
                      "databaseId": "HaT001",
                      "loadGroupId": "playerNHoldings",
                      "quantity": 1,
                      "left": "38%",
                      "top": "22%"
                    },
                    {
                      "databaseId": "Emperor028",
                      "loadGroupId": "playerNHoldings",
                      "quantity": 1,
                      "left": "58%",
                      "top": "22%"
                    }
                  ]
                ],
                [
                  "LOG",
                  "{{$ALIAS_N}} received Bamboo Harvesters and Border Keep."
                ]
              ]
            ]
          ],
          [
            "SHUFFLE_GROUP",
            "{{$PLAYER_N}}Dynasty"
          ],
          [
            "SHUFFLE_GROUP",
            "{{$PLAYER_N}}Fate"
          ],
          [
            "REFILL_PROVINCE",
            "{{$PLAYER_N}}Province1"
          ],
          [
            "REFILL_PROVINCE",
            "{{$PLAYER_N}}Province2"
          ],
          [
            "REFILL_PROVINCE",
            "{{$PLAYER_N}}Province3"
          ],
          [
            "REFILL_PROVINCE",
            "{{$PLAYER_N}}Province4"
          ],
          [
            "MOVE_STACKS",
            "{{$PLAYER_N}}Fate",
            "{{$PLAYER_N}}Hand",
            5,
            "bottom"
          ],
          [
            "LOG",
            "{{$ALIAS_N}} seated a clan: stronghold and sensei in place, provinces filled, five fate drawn."
          ],
          [
            "COND",
            [
              "EQUAL",
              "$PLAYER_N",
              "$GAME.firstPlayer"
            ],
            [
              "START_TURN",
              "$PLAYER_N"
            ]
          ]
        ]
      ]
    ],
    "postMoveStackActionList": [
      [
        "COND",
        [
          "AND",
          [
            "IN_STRING",
            "$ORIG_GROUP_ID",
            "Province"
          ],
          [
            "NOT_EQUAL",
            "$ORIG_GROUP_ID",
            "$DEST_GROUP_ID"
          ]
        ],
        [
          [
            "REFILL_PROVINCE",
            "$ORIG_GROUP_ID"
          ]
        ]
      ],
      [
        "COND",
        [
          "AND",
          [
            "EQUAL",
            "$ORIG_PARENT_CARD.databaseId",
            "l5r-imperial-favor"
          ],
          [
            "IN_STRING",
            "$DEST_GROUP_ID",
            "Play"
          ]
        ],
        [
          [
            "MOVE_CARD",
            "$ORIG_PARENT_CARD.id",
            "{{$DEST_PARENT_CARD.controller}}Favor",
            0
          ],
          [
            "APPLY_FAVOR_ART",
            "$DEST_PARENT_CARD.controller",
            "$ORIG_PARENT_CARD.id"
          ],
          [
            "LOG",
            "The Imperial Favor snapped to that clan's favor slot."
          ]
        ]
      ],
      [
        "COND",
        [
          "AND",
          [
            "EQUAL",
            "$ORIG_PARENT_CARD.databaseId",
            "l5r-imperial-favor"
          ],
          [
            "IN_STRING",
            "$DEST_GROUP_ID",
            "Favor"
          ],
          [
            "NOT_EQUAL",
            "$DEST_GROUP_ID",
            "sharedFavor"
          ]
        ],
        [
          [
            "VAR",
            "$OWNER",
            [
              "REGEX_REPLACE",
              "$DEST_GROUP_ID",
              "(player[0-9]+).*",
              "\\1"
            ]
          ],
          [
            "APPLY_FAVOR_ART",
            "$OWNER",
            "$ORIG_PARENT_CARD.id"
          ]
        ]
      ],
      [
        "COND",
        [
          "AND",
          [
            "EQUAL",
            "$ORIG_PARENT_CARD.databaseId",
            "l5r-imperial-favor"
          ],
          [
            "EQUAL",
            "$DEST_GROUP_ID",
            "sharedFavor"
          ]
        ],
        [
          [
            "RESET_FAVOR_ART",
            "$ORIG_PARENT_CARD.id"
          ]
        ]
      ],
      [
        "COND",
        [
          "AND",
          [
            "EQUAL",
            "$ORIG_PARENT_CARD.databaseId",
            "l5r-imperial-favor"
          ],
          [
            "OR",
            [
              "IN_STRING",
              "$DEST_GROUP_ID",
              "Discard"
            ],
            [
              "IN_STRING",
              "$DEST_GROUP_ID",
              "Removed"
            ]
          ]
        ],
        [
          [
            "MOVE_CARD",
            "$ORIG_PARENT_CARD.id",
            "sharedFavor",
            0
          ],
          [
            "RESET_FAVOR_ART",
            "$ORIG_PARENT_CARD.id"
          ],
          [
            "LOG",
            "The Imperial Favor returned to the middle."
          ]
        ]
      ]
    ],
    "gameRules": {
      "refillEmptyProvince": {
        "type": "trigger",
        "listenTo": [
          "/groupById/*/stackIds"
        ],
        "condition": [
          "AND",
          [
            "IN_STRING",
            "$TARGET_ID",
            "Province"
          ],
          [
            "EQUAL",
            [
              "LENGTH",
              "$TARGET.stackIds"
            ],
            0
          ],
          [
            "NOT",
            [
              "EQUAL",
              "$TARGET.destroyed",
              true
            ]
          ]
        ],
        "then": [
          [
            "REFILL_PROVINCE",
            "$TARGET_ID"
          ]
        ]
      },
      "startOfTurn": {
        "type": "trigger",
        "listenTo": [
          "/stepId"
        ],
        "condition": [
          "AND",
          [
            "EQUAL",
            "$GAME.stepId",
            "dynastyStep"
          ],
          [
            "NOT_EQUAL",
            [
              "PREV",
              "$GAME.stepId"
            ],
            "dynastyStep"
          ]
        ],
        "then": [
          [
            "COND",
            [
              "EQUAL",
              [
                "PREV",
                "$GAME.stepId"
              ],
              "endStep"
            ],
            [
              [
                "VAR",
                "$NEXT",
                [
                  "NEXT_PLAYER",
                  "$GAME.firstPlayer"
                ]
              ],
              [
                "COND",
                [
                  "DEFINED",
                  "$GAME.playerInfo.{{$NEXT}}.id"
                ],
                [
                  [
                    "SET",
                    "/firstPlayer",
                    "$NEXT"
                  ]
                ]
              ]
            ]
          ],
          [
            "COND",
            [
              "DEFINED",
              "$GAME.playerInfo.{{$GAME.firstPlayer}}.id"
            ],
            [
              "START_TURN",
              "$GAME.firstPlayer"
            ]
          ]
        ]
      },
      "revealEvent": {
        "type": "trigger",
        "listenTo": [
          "/cardById/*/currentSide"
        ],
        "condition": [
          "AND",
          [
            "IN_STRING",
            "$TARGET.groupId",
            "Province"
          ],
          [
            "EQUAL",
            "$TARGET.currentSide",
            "A"
          ],
          [
            "NOT_EQUAL",
            [
              "PREV",
              "$TARGET.currentSide"
            ],
            "A"
          ],
          [
            "EQUAL",
            "$TARGET.currentFace.type",
            "Event"
          ]
        ],
        "then": [
          [
            "FADE_TEXT_GAME",
            "EVENT"
          ],
          [
            "LOG",
            "{{$TARGET.currentFace.name}} is an Event."
          ],
          [
            "ADD_FACEDOWN_DYNASTY",
            "$TARGET.groupId"
          ]
        ]
      }
    }
  }
}
