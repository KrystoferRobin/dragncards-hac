{
  "actionLists": {
    "drawDeck": [
      ["COND",
        ["GROUP_EMPTY", "{{$PLAYER_N}}Deck"],
        ["LOG", "{{$ALIAS_N}} tried to draw from an empty deck."],
        ["TRUE"],
        [
          ["MOVE_STACKS", "{{$PLAYER_N}}Deck", "{{$PLAYER_N}}Hand", 1, "bottom"],
          ["LOG", "{{$ALIAS_N}} drew a card."]
        ]
      ]
    ],
    "shuffleDeck": [
      ["SHUFFLE_GROUP", "{{$PLAYER_N}}Deck"],
      ["LOG", "{{$ALIAS_N}} shuffled their deck."]
    ],
    "untackAll": [
      ["FOR_EACH_KEY_VAL", "$CARD_ID", "$CARD", "$GAME.cardById",
        ["COND",
          ["EQUAL", "$CARD.controller", "$PLAYER_N"],
          ["SET", "/cardById/{{$CARD_ID}}/rotation", 0]
        ]
      ],
      ["LOG", "{{$ALIAS_N}} untacked all their cards."]
    ],
    "tackCard": [
      ["SET", "/cardById/$ACTIVE_CARD_ID/rotation", 90],
      ["LOG", "{{$ALIAS_N}} tacked {{$ACTIVE_FACE.name}}."]
    ],
    "untackCard": [
      ["SET", "/cardById/$ACTIVE_CARD_ID/rotation", 0],
      ["LOG", "{{$ALIAS_N}} untacked {{$ACTIVE_FACE.name}}."]
    ],
    "roll1d6": [
      ["VAR", "$D1", ["RANDOM_INT", 1, 6]],
      ["LOG", "{{$ALIAS_N}} rolled 1d6: {{$D1}}."],
      ["FADE_TEXT_GAME", "{{$ALIAS_N}} 1d6: {{$D1}}"]
    ],
    "discardTop": [
      ["COND",
        ["GROUP_EMPTY", "{{$PLAYER_N}}Deck"],
        ["LOG", "{{$ALIAS_N}} tried to discard from an empty deck."],
        ["TRUE"],
        [
          ["MOVE_STACKS", "{{$PLAYER_N}}Deck", "{{$PLAYER_N}}Discard", 1, "bottom"],
          ["LOG", "{{$ALIAS_N}} discarded the top of their deck."]
        ]
      ]
    ],
    "flipCard": [
      ["FLIP", "$ACTIVE_CARD_ID"]
    ],
    "discardCard": [
      ["DISCARD", "$ACTIVE_CARD_ID"]
    ],
    "sinkCard": [
      ["VAR", "$CARD", "$GAME.cardById.$ACTIVE_CARD_ID"],
      ["LOG", "{{$ALIAS_N}} sunk {{$ACTIVE_FACE.name}}."],
      ["MOVE_CARD", "$ACTIVE_CARD_ID", "{{$PLAYER_N}}Sunk", 0]
    ],
    "detachCard": [
      ["DETACH", "$ACTIVE_CARD_ID"]
    ],
    "shuffleIntoDeck": [
      ["SHUFFLE_INTO_DECK", "$ACTIVE_CARD_ID"]
    ],
    "loadSeas": [
      ["LOAD_CARDS", "theahSeas"]
    ]
  }
}
