{
  "actionLists": {
    "drawTreasure": [
      ["COND",
        ["GROUP_EMPTY", "{{$PLAYER_N}}TreasureHorde"],
        ["LOG", "{{$ALIAS_N}} tried to draw from an empty Treasure Horde."],
        ["TRUE"],
        [
          ["MOVE_STACKS", "{{$PLAYER_N}}TreasureHorde", "{{$PLAYER_N}}Hand", 1, "bottom"],
          ["LOG", "{{$ALIAS_N}} drew from the Treasure Horde."]
        ]
      ]
    ],
    "drawDragon": [
      ["COND",
        ["GROUP_EMPTY", "{{$PLAYER_N}}DragonLair"],
        ["LOG", "{{$ALIAS_N}} tried to draw from an empty Dragon Lair."],
        ["TRUE"],
        [
          ["MOVE_STACKS", "{{$PLAYER_N}}DragonLair", "{{$PLAYER_N}}DragonLairHand", 1, "bottom"],
          ["LOG", "{{$ALIAS_N}} drew from the Dragon Lair."]
        ]
      ]
    ],
    "flipCoin": [
      ["VAR", "$FLIP", ["RANDOM_INT", 0, 1]],
      ["COND",
        ["EQUAL", "$FLIP", 0],
        ["LOG", "{{$ALIAS_N}} flipped a coin: Heads."],
        ["TRUE"],
        ["LOG", "{{$ALIAS_N}} flipped a coin: Tails."]
      ]
    ],
    "increaseGold": [
      ["INCREASE_VAL", "/playerData/$PLAYER_N/gold", 1],
      ["LOG", "{{$ALIAS_N}} gained 1 gold."]
    ],
    "decreaseGold": [
      ["COND",
        ["GREATER_THAN", "$GAME.playerData.$PLAYER_N.gold", 0],
        [
          ["DECREASE_VAL", "/playerData/$PLAYER_N/gold", 1],
          ["LOG", "{{$ALIAS_N}} spent 1 gold."]
        ],
        ["TRUE"],
        ["LOG", "{{$ALIAS_N}} has no gold to spend."]
      ]
    ],
    "flipCard": [
      ["FLIP", "$ACTIVE_CARD_ID"]
    ],
    "discardCard": [
      ["DISCARD", "$ACTIVE_CARD_ID"]
    ],
    "detachCard": [
      ["DETACH", "$ACTIVE_CARD_ID"]
    ],
    "shuffleIntoDeck": [
      ["SHUFFLE_INTO_DECK", "$ACTIVE_CARD_ID"]
    ]
  }
}
