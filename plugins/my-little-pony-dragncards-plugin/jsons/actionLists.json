{
  "actionLists": {
    "drawDeck": [
      ["COND",
        ["GROUP_EMPTY", "{{$PLAYER_N}}Deck"],
        ["LOG", "{{$ALIAS_N}} tried to draw from an empty deck."],
        ["TRUE"],
        [
          ["MOVE_STACKS", "{{$PLAYER_N}}Deck", "{{$PLAYER_N}}Hand", 1, "bottom"],
          ["LOG", "{{$ALIAS_N}} drew a card."]
        ]
      ]
    ],
    "shuffleDeck": [
      ["SHUFFLE_GROUP", "{{$PLAYER_N}}Deck"],
      ["LOG", "{{$ALIAS_N}} shuffled their deck."]
    ],
    "shuffleSceneDeck": [
      ["SHUFFLE_GROUP", "{{$PLAYER_N}}SceneDeck"],
      ["LOG", "{{$ALIAS_N}} shuffled their scene deck."]
    ],
    "addScene": [
      ["COND",
        ["GROUP_EMPTY", "{{$PLAYER_N}}SceneDeck"],
        ["LOG", "{{$ALIAS_N}} tried to add a scene from an empty scene deck."],
        ["TRUE"],
        [
          ["MOVE_STACKS", "{{$PLAYER_N}}SceneDeck", "{{$PLAYER_N}}Scenes", 1, "bottom"],
          ["LOG", "{{$ALIAS_N}} added a scene."]
        ]
      ]
    ],
    "addPlan": [
      ["COND",
        ["GROUP_EMPTY", "{{$PLAYER_N}}Deck"],
        ["LOG", "{{$ALIAS_N}} tried to add a plan from an empty deck."],
        ["TRUE"],
        [
          ["MOVE_STACKS", "{{$PLAYER_N}}Deck", "{{$PLAYER_N}}Plans", 1, "bottom"],
          ["LOG", "{{$ALIAS_N}} added a plan."]
        ]
      ]
    ],
    "takePlan": [
      ["COND",
        ["GROUP_EMPTY", "{{$PLAYER_N}}Plans"],
        ["LOG", "{{$ALIAS_N}} tried to take a plan from an empty plans pile."],
        ["TRUE"],
        [
          ["MOVE_STACKS", "{{$PLAYER_N}}Plans", "{{$PLAYER_N}}Hand", 1, "bottom"],
          ["LOG", "{{$ALIAS_N}} took a plan into their hand."]
        ]
      ]
    ],
    "plansToTable": [
      ["COND",
        ["GROUP_EMPTY", "{{$PLAYER_N}}Plans"],
        ["LOG", "{{$ALIAS_N}} tried to play a plan from an empty plans pile."],
        ["TRUE"],
        [
          ["MOVE_STACKS", "{{$PLAYER_N}}Plans", "{{$PLAYER_N}}Lane2", 1, "bottom"],
          ["LOG", "{{$ALIAS_N}} played a plan to the center adventure lane."]
        ]
      ]
    ],
    "untapAll": [
      ["FOR_EACH_KEY_VAL", "$CARD_ID", "$CARD", "$GAME.cardById",
        ["COND",
          ["EQUAL", "$CARD.controller", "$PLAYER_N"],
          ["SET", "/cardById/{{$CARD_ID}}/rotation", 0]
        ]
      ],
      ["LOG", "{{$ALIAS_N}} untapped all their cards."]
    ],
    "tapCard": [
      ["SET", "/cardById/$ACTIVE_CARD_ID/rotation", 90],
      ["LOG", "{{$ALIAS_N}} tapped {{$ACTIVE_FACE.name}}."]
    ],
    "untapCard": [
      ["SET", "/cardById/$ACTIVE_CARD_ID/rotation", 0],
      ["LOG", "{{$ALIAS_N}} untapped {{$ACTIVE_FACE.name}}."]
    ],
    "roll1d6": [
      ["VAR", "$D1", ["RANDOM_INT", 1, 6]],
      ["LOG", "{{$ALIAS_N}} rolled 1d6: {{$D1}}."],
      ["FADE_TEXT_GAME", "{{$ALIAS_N}} 1d6: {{$D1}}"]
    ],
    "flipCard": [
      ["FLIP", "$ACTIVE_CARD_ID"]
    ],
    "discardCard": [
      ["DISCARD", "$ACTIVE_CARD_ID"]
    ],
    "detachCard": [
      ["DETACH", "$ACTIVE_CARD_ID"]
    ],
    "shuffleIntoDeck": [
      ["SHUFFLE_INTO_DECK", "$ACTIVE_CARD_ID"]
    ]
  }
}
