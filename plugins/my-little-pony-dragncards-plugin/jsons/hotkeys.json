{
  "hotkeys": {
    "game": [
      {"key": "D", "actionList": "drawDeck", "label": "Draw"},
      {"key": "S", "actionList": "shuffleDeck", "label": "Shuffle deck"},
      {"key": "N", "actionList": "addScene", "label": "Add scene"},
      {"key": "U", "actionList": "untapAll", "label": "Untap all"},
      {"key": "R", "actionList": "roll1d6", "label": "Roll 1d6"},
      {"key": "P", "actionList": "addPlan", "label": "Add plan"},
      {"key": "G", "actionList": "takePlan", "label": "Take plan"}
    ],
    "card": [
      {"key": "T", "actionList": "tapCard", "label": "Tap"},
      {"key": "K", "actionList": "untapCard", "label": "Untap"},
      {"key": "F", "actionList": ["FLIP", "$ACTIVE_CARD_ID"], "label": "Flip card"},
      {"key": "X", "actionList": ["DISCARD", "$ACTIVE_CARD_ID"], "label": "Retire"},
      {"key": "A", "actionList": ["DETACH", "$ACTIVE_CARD_ID"], "label": "Detach"},
      {"key": "H", "actionList": ["SHUFFLE_INTO_DECK", "$ACTIVE_CARD_ID"], "label": "Shuffle into associated deck"}
    ],
    "token": [
      {"key": "1", "tokenType": "green", "label": "Counter"}
    ]
  }
}
