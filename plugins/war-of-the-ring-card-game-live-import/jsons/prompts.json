{
  "prompts": {
    "cardEnteredPlayThisRound": {
      "args": [
        "$PLAYED_CARD_NAME"
      ],
      "message": "{{$PLAYED_CARD_NAME}} was played this round already. Characters and Items can only be played once per round.",
      "options": [
        {
          "hotkey": "K",
          "label": "Ok"
        }
      ]
    },
    "eliminateOnPlay": {
      "args": [
        "$PLAYED_CARD_NAME",
        "$ELIMINATE_CARD_NAME"
      ],
      "message": "{{$PLAYED_CARD_NAME}} was played. Eliminate {{$ELIMINATE_CARD_NAME}}?",
      "options": [
        {
          "code": [
            [
              "VAR",
              "$ELIMINATE_CARD",
              [
                "ONE_CARD",
                "$CARD",
                [
                  "EQUAL",
                  "$CARD.sides.A.name",
                  "$ELIMINATE_CARD_NAME"
                ]
              ]
            ],
            [
              "LOG",
              "{{$ALIAS_N}} eliminated {{$ELIMINATE_CARD_NAME}}."
            ],
            [
              "MOVE_CARD",
              "$ELIMINATE_CARD.id",
              "{{$ELIMINATE_CARD.controller}}Eliminated",
              0
            ]
          ],
          "hotkey": "Y",
          "label": "Yes"
        },
        {
          "hotkey": "N",
          "label": "No"
        }
      ]
    },
    "notifyAll": {
      "args": [
        "$MESSAGE"
      ],
      "message": "{{$MESSAGE}}",
      "options": [
        {
          "hotkey": "K",
          "label": "Ok"
        }
      ]
    },
    "playNumberedCardToReserve": {
      "args": [
        "$PLAYER_I",
        "$GROUP_ID"
      ],
      "message": "Press the option corresponding to the card you want to play to reserve.",
      "options": [
        {
          "code": [
            "PLAY_NUMBERED_CARD_TO_RESERVE",
            "$PLAYER_I",
            "$GROUP_ID",
            0
          ],
          "hotkey": "1",
          "label": "1"
        },
        {
          "code": [
            "PLAY_NUMBERED_CARD_TO_RESERVE",
            "$PLAYER_I",
            "$GROUP_ID",
            1
          ],
          "hotkey": "2",
          "label": "2"
        },
        {
          "code": [
            "PLAY_NUMBERED_CARD_TO_RESERVE",
            "$PLAYER_I",
            "$GROUP_ID",
            2
          ],
          "hotkey": "3",
          "label": "3"
        },
        {
          "code": [
            "PLAY_NUMBERED_CARD_TO_RESERVE",
            "$PLAYER_I",
            "$GROUP_ID",
            3
          ],
          "hotkey": "4",
          "label": "4"
        },
        {
          "code": [
            "PLAY_NUMBERED_CARD_TO_RESERVE",
            "$PLAYER_I",
            "$GROUP_ID",
            4
          ],
          "hotkey": "5",
          "label": "5"
        },
        {
          "code": [
            [
              "LOG",
              [
                "GET_ALIAS",
                "$PLAYER_I"
              ],
              " chose no card."
            ],
            [
              "CYCLE_TOP_N_CARDS",
              "$GROUP_ID",
              5
            ],
            [
              "SET",
              "/playerData/$PLAYER_I/browseGroup/id",
              null
            ]
          ],
          "hotkey": "N",
          "label": "None"
        }
      ]
    }
  }
}
