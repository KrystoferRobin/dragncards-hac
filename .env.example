# Copy to `.env` next to compose.yml (Compose loads it automatically).

# Card art on the big drives (nginx /cards/). Postgres is a Docker volume, not here.
DRAGNCARDS_DATA=/fileshare/services/dragncards

DRAGN_INVITE_CODE=changeme
HAVEN_LFG_WEBHOOK_URL=
# Public site URL for LFG link-backs (no trailing slash).
DRAGNCARDS_PUBLIC_URL=
